[Unit]
Description=DCA Web (Flask + SocketIO)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=oneclimate-dev
WorkingDirectory=/home/oneclimate-dev/yterayut-project/DCA
EnvironmentFile=/home/oneclimate-dev/yterayut-project/DCA/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/oneclimate-dev/yterayut-project/DCA/venv/bin/python app.py
Restart=always
RestartSec=5
LimitNOFILE=65535
SyslogIdentifier=dca-web
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
